{
  "name": "transom",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -n daemon,client -c cyan,magenta \"npm:dev:daemon\" \"npm:dev:client\"",
    "dev:daemon": "node tools/free-port.mjs 8787 && tsx watch server/index.ts",
    "dev:client": "vite",
    "sim": "tsx server/sim.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "demo:stage": "tsx tools/demo-set.ts stage",
    "demo:pack": "tsx tools/demo-set.ts pack",
    "site": "tsx tools/site.ts",
    "doctor": "tsx tools/doctor.ts",
    "daemon:restart": "launchctl kickstart -k gui/$(id -u)/tech.michaelbaker.transom.daemon && echo \"daemon restarted\" && sleep 1 && npm run --silent doctor"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "@weasel-js/core": "^1.9.0",
    "@weasel-js/labkit": "^1.9.0",
    "@weasel-js/ui": "^1.9.0",
    "ajv": "^8.20.0",
    "chokidar": "^5.0.0",
    "delamin8r": "^0.2.1",
    "express": "^5.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "three": "^0.186.1",
    "windease": "^2.0.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
