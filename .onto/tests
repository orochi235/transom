enlist: 3
plugin: node
run: npm run typecheck && npm test
# No `runner:`: its reporter goes on the end of `run:`, so `run:` must be one
# command. A package script ending in `vitest run` would carry it.

# The gate is both halves. `npm test` alone passes on a tree that does not
# compile, because vitest transpiles per file and never checks across them.

# vitest.config.ts aliases both to their source beside this checkout, and
# package.json names only the published packages.
with: ../windease ../delamin8r

# No `.nvmrc`: the repo pins no version, so onto-node leaves the node's own
# Node on the PATH (Homebrew's node 26 on this fleet).
