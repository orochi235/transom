#!/bin/sh
# transom: a wall for renders. One command sends to it, asks on it and runs it.
#
#   transom post FILE...          puts it on the wall and returns
#   some-generator | transom post reads stdin, writes a .png
#   transom ask "QUESTION" FILE   asks on the card, waits, prints the answer
#   transom wait PATH             waits on a question already sent, by the path
#                                 `transom ask --no-wait` printed
#   transom zone                  prints the zone this repo resolves to
#   transom install               writes the wall's launchd agents and loads them
#   transom up | down | cycle     starts, stops or restarts them
#   transom stat                  what launchd thinks, and whether they answer
#   transom wire [--off] [--dry]  the skill, the hook and this command, for
#                                 Claude Code
#   transom pair HOST             lets another Mac send here (run on the wall)
#
# `post` and `ask` both take:
#   --zone Z                   the zone; defaults to the repo directory name
#   --ttl 5m                   how long it lives; a bare number is seconds
#   --caption "what it shows"
#   --attention look           asks to be looked at. Levels: look, soon, urgent,
#                              problem. Also `look:90s`, `30m`, `until-dismissed`.
#   --note "what it needs"     badge text on a flagged card
#   --sandbox "allow-scripts allow-forms"
#                              what an HTML page may do in the lightbox. `none`
#                              removes the sandbox entirely. Whoever pushes the
#                              page decides this; the wall applies what it is told.
#   --group sweep-3            a take in a group: every send naming the same group
#                              joins one card, which the lightbox pages through.
#                              `--group-label "outline sweep"` names it on the wall
#                              and `--of 12` says how many are coming.
#   --app LDView               offers "Open in LDView" in the lightbox, on the
#                              artifact itself. `--app "LDView=parts/3001.dat"`
#                              hands it another file instead. Repeatable.
#   --link "part 3001=https://rebrickable.com/parts/3001/"
#                              a link in the lightbox. Without an `=` the label
#                              is the URL's host. http(s) only. Repeatable.
#
# `ask` also takes:
#   --choice left              a chip to answer with. Repeatable. With none, the
#                              answer is free text.
#   --why                      also offers a free-text box under the choices.
#                              `--why "what is off about it?"` sets its
#                              placeholder; bare, the wall picks the words.
#   --json                     prints the whole reply rather than the answer
#                              alone: the status, the chip and the text.
#   --no-wait                  sends the question and returns, printing where it
#                              landed. Collect the answer with `transom wait`.
#
# `ask` exits 3 if the question is dismissed and 4 if the card is expired
# first. It exits 5 if the viewer drew on the picture instead (*No, like this*):
# it prints the marked-up PNG's path, then any text they wrote. It blocks, so
# run it in the background.
#
# Run from Claude Code, a send records the session it came from, so a picture
# marked up on the wall later goes back to that session while it is running.
#
# A video's card is a poster frame and the lightbox plays it. Needs ffmpeg.
#
# Writing the file is the whole protocol; there is nothing to start or connect to.
# Provenance rides in a `<image>.transom.json` sidecar the daemon folds into the
# image's own metadata: the caption, plus the repo and commit this ran in. The
# sidecar is written first, because the image landing is what the daemon
# triggers on.
set -eu

usage() { sed -n '2,64p' "$0" | sed 's/^# \{0,1\}//'; }

# `wire` leaves this on PATH as a symlink, and the rest of the checkout is
# beside the file it points at. Homebrew's formula says where instead.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in /*) self=$link ;; *) self=$(dirname -- "$self")/$link ;; esac
done
TRANSOM_HOME=${TRANSOM_HOME:-$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd)}
export TRANSOM_HOME

verb=${1:-help}
[ $# -gt 0 ] && shift
case "$verb" in
  post|ask|wait|zone) ;;
  protocol) echo 1; exit 0 ;;
  pair) exec sh "$TRANSOM_HOME/libexec/pair" "$@" ;;
  install|up|down|cycle|stat|wire)
    if [ "$verb" = wire ]; then exec node "$TRANSOM_HOME/libexec/wire.mjs" "$@"; fi
    exec sh "$TRANSOM_HOME/libexec/agents" "$verb" "$@"
    ;;
  help|-h|--help) usage; exit 0 ;;
  *) echo "transom: no such command: $verb" >&2; usage >&2; exit 1 ;;
esac

. "$TRANSOM_HOME/libexec/send.sh"
